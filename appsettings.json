{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//secrets": [
    "Jwt:Key, ConnectionStrings:Default, SuperAdmin:Email and SuperAdmin:Password are",
    "deliberately absent from this file, because this file is committed. Set them in",
    ".env (see .env.example) or in the environment. Start-up fails on a missing Jwt:Key."
  ],
  "Jwt": {
    "Issuer": "educore",
    "Audience": "educore-api",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Grading": {
    "FirstMarkWeight": 0.4,
    "SecondMarkWeight": 0.6,
    "PassMark": 2,
    "AtRiskMark": 2
  },
  "Privacy": {
    "MinimumCellSize": 5
  },
  "Assignment": {
    "MaxSubjectsPerTeacher": 2
  },
  "AcademicCalendar": {
    "FirstPeriodEnd": "12-26",
    "SecondPeriodStart": "01-07"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "storage",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/gif",
      "image/webp",
      "text/plain",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    ]
  },
  "Session": {
    "CookieName": "educore.session",
    "CsrfCookieName": "educore.csrf",
    "CsrfHeaderName": "X-CSRF-Token",
    "SameSite": "Lax",
    "Secure": true,
    "Domain": null
  }
}
