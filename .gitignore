bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/
.idea/
# IDE/editor local state
.vs/
.idea/
*.user
*.DotSettings.user

# Secrets. .env holds the JWT signing key, the database password and the first
# super administrator's credentials -- see .env.example for the names, and
# Security/DotEnvFile.cs for how it is read.
.env
.env.local
.env.*.local

# Uploaded student documents kept by the local file-storage backend (Storage:LocalRoot).
# User data, never committed.
/storage/
.neon

# TLS material for the compose stack (mounted into nginx read-only). The private key
# never belongs in git; generate a self-signed pair or drop a real certificate here --
# see .env.example for the openssl command.
/certs/
