# Copy to .env and fill in. .env is gitignored; this file is not, and must never
# hold a real value.
#
# Double underscore is .NET's section separator, so Jwt__Key here is Jwt:Key in
# configuration. A real environment variable of the same name always wins over
# this file, which is how a deployment supplies its secrets without shipping one.

# The HS256 signing key for every token the API issues. At least 32 bytes, or
# start-up fails. Generate one with:  openssl rand -base64 32
#
# This is the whole of the app's security: every authorization decision is made
# from claims, and claims are only worth anything because this key is secret.
# Anyone holding it can mint a SuperAdmin token for any school.
Jwt__Key=

ConnectionStrings__Default=Host=localhost;Port=5434;Database=EduCoreDB;Username=CHANGE_ME;Password=CHANGE_ME

# Used once, on a database that has no super administrator, to create the first
# one. Leave both blank on a system that already has one and nothing is created.
# The account is forced to change this password on first sign-in; it must still
# be at least 12 characters.
SuperAdmin__Email=
SuperAdmin__Password=

# docker compose reads this same file for the database container, so these three
# and the connection string above have to agree. The compose defaults
# (educore / educore123) are development-only and must not be used anywhere real.
POSTGRES_DB=EduCoreDB
POSTGRES_USER=
POSTGRES_PASSWORD=
