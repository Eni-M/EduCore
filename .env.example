# Copy to .env and fill in. .env is gitignored; this file is not, and must never
# hold a real value. `docker compose` reads this same .env, and so does the app when
# run locally (double underscore is .NET's section separator: Jwt__Key -> Jwt:Key).

# The HS256 signing key for every token the API issues. At least 32 bytes, or
# start-up fails. Generate one with:  openssl rand -base64 32
Jwt__Key=

# The key that encrypts national identifiers (student personal numbers, guardian national
# IDs) at rest. Must be a base64-encoded 32-byte key, or start-up fails. Generate one with:
# openssl rand -base64 32
# WARNING: changing this key makes existing encrypted values unreadable. Keep it stable and
# back it up alongside the database.
Encryption__Key=

# First run only, on a database with no super administrator: creates the first one
# (forced to change the password on first sign-in; must be at least 12 characters).
# Leave both blank afterwards.
SuperAdmin__Email=
SuperAdmin__Password=

# Database. compose uses these for the db container and the API's connection string.
POSTGRES_DB=EduCoreDB
POSTGRES_USER=educore
POSTGRES_PASSWORD=

# Applies pending migrations at start-up instead of as a separate step. Leave false here:
# compose already runs the one-shot `migrate` service before the API, which is the better shape.
# Set true only on a single-instance host with no separate migration step -- a free Render
# service, where the pre-deploy command is a paid feature. Two replicas with this on will race
# each other to migrate, which is the defect the `migrate` service exists to prevent.
MigrateOnStart=false

# Mail. Provider Log (the default) delivers nothing and writes messages to the application
# log; password reset and the daily schedule digests are silently useless in that mode.
# Set Provider to Smtp with the settings below to deliver for real. Any SMTP relay works --
# your own mail server, Gmail (smtp.gmail.com:587, an App Password, not the account
# password), Brevo, SendGrid. Port 587 = STARTTLS; for 465 set Email__UseSslOnConnect=true.
# Leave Username/Password empty for a relay that authorizes by IP address.
Email__Provider=Log
Email__Host=
Email__Port=587
Email__FromAddress=
Email__FromName=EduCore
Email__Username=
Email__Password=

# Metrics and traces. Metrics are counters and timings scraped from /metrics -- "is the system
# healthy". Traces follow one request through the app and its SQL -- "why did THIS request fail
# or take four seconds". Traces are collected in process regardless, so the trace id shown in an
# error response always corresponds to a real recorded request; set OtlpEndpoint to ship them to
# a collector (Jaeger, Tempo, Grafana, Azure Monitor) once one exists.
Observability__ServiceName=educore-api
Observability__OtlpEndpoint=
Observability__TraceSampleRatio=1.0
# /metrics is meant to be reachable from the monitoring network, not the internet. Set true to
# require a signed-in caller if it will be exposed more widely.
Observability__MetricsRequireAuthentication=false

# TLS. nginx in the web service terminates https using certs/fullchain.pem and
# certs/privkey.pem, and the :80 listener does nothing but redirect to PUBLIC_ORIGIN.
# Generate a self-signed pair for local use (one year, valid for localhost):
#   mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout certs/privkey.pem -out certs/fullchain.pem \
#     -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
# On Git Bash for Windows, prefix the command with MSYS_NO_PATHCONV=1 or Git Bash
# rewrites /CN=localhost into a Windows path.
# The browser will warn once for a self-signed certificate; that is expected locally
# and is not acceptable for anything public -- use a real certificate there.
PUBLIC_ORIGIN=https://localhost:8443
CERT_DIR=./certs

# Seconds for the Strict-Transport-Security header. Leave 0 locally: HSTS is scoped to
# the host and ignores the port, so pinning `localhost` would force https on the http
# dev servers at :5173 and :5128. Use 31536000 (one year) on a real domain.
HSTS_MAX_AGE=0

# Session__Secure is deliberately not set here. compose defaults it to true, and this
# file is also read by a local `dotnet run` (see Security/DotEnvFile.cs) where an
# environment variable outranks appsettings.Development.json -- setting it here would
# mark cookies Secure on the plain-http dev loop too. Set it to false only to run the
# Docker stack without TLS on purpose.

# Host ports. The app is served at ${PUBLIC_ORIGIN}; WEB_PORT only carries the
# http -> https redirect.
WEB_PORT=8080
WEB_HTTPS_PORT=8443
DB_PORT=5434

# Only needed when running the API locally (dotnet run) instead of in compose:
# ConnectionStrings__Default=Host=localhost;Port=5434;Database=EduCoreDB;Username=educore;Password=educore123
